---
// The sponsors of an Edition by tier: equal cells per tier, each logo centered in its cell (see wall.css).
// The home page's sponsor wall, the sponsors page, the 2026 page and the earlier Editions' pages use it. 2026 lists
// every tier; 2027 lists the tiers that have a sponsor, and a sponsor without a logo shows its name as a text tile.
// An earlier Edition (2025, 2024) passes its tiers: each takes the cell size of a 2026 tier (`size`), a sponsor
// without an official logo file shows by name, and past.css sets each logo's aspect ratio, so every logo in a tier
// covers the same area. Past walls never show credits.
import { Image } from 'astro:assets';
import { edition2026 } from '../data/edition-2026';
import { sponsors2027, type Tier2027 } from '../data/sponsors-2027';
import type { PastTier } from '../data/edition-2025';
import { logos } from '../lib/images';
import Credit from './program/Credit.astro';
import { sponsorCredit, type Credit as CreditData } from '../lib/loyalty';

type Props =
  | {
    /** Put before each tier name, such as "2026". */
    tierPrefix?: string;
    edition?: 2026 | 2027;
  }
  | {
    tierPrefix?: string;
    edition: 2024 | 2025;
    /** An earlier Edition's tiers, from its edition file. */
    tiers: readonly PastTier[];
  };
const { tierPrefix, edition = 2026 } = Astro.props;

// `credit`: "Since 2026" for a 2027 sponsor that backed an earlier Edition (src/lib/loyalty.ts), shown under its
// tile.
type Entry = { id: string | null; name: string; link?: string; credit?: CreditData | null; sample?: boolean };
type Tier = { class: string; name: string; sponsors: readonly Entry[] };
const names: Record<Tier2027, string> = { platinum: 'Platinum', gold: 'Gold', silver: 'Silver' };
const tiers: Tier[] = 'tiers' in Astro.props
  ? Astro.props.tiers.map((t) => ({
    class: `tier--${t.size} tier--n${t.sponsors.length}`,
    name: t.name,
    sponsors: t.sponsors.map((s) => ({ id: s.logo ? s.id : null, name: s.name })),
  }))
  : edition === 2026
    ? [
      { class: 'tier--platinum', name: 'Platinum', sponsors: edition2026.sponsors.platinum },
      { class: 'tier--gold', name: 'Gold', sponsors: edition2026.sponsors.gold },
      { class: 'tier--silver', name: 'Silver', sponsors: edition2026.sponsors.silver },
    ]
    : (Object.keys(names) as Tier2027[])
      .map((key) => ({ class: `tier--${key}`, name: names[key], sponsors: sponsors2027.filter((s) => s.tier === key).map((s) => ({ id: s.logo, name: s.alt || s.name, link: s.link, credit: sponsorCredit(s.id), sample: s.sample })) }))
      .filter((t) => t.sponsors.length > 0);
---

<div class="tiers">
  {tiers.map((t) => (
    <div class={`tier ${t.class}`}>
      <h3 class="tier-name">{tierPrefix ? `${tierPrefix} ${t.name}` : t.name}</h3>
      <ul class="logos">
        {t.sponsors.map((s) => {
          const mark = s.id ? <Image class="sp-logo" data-logo={s.id} src={logos[s.id]} alt={s.name} /> : <span class="sp-name" data-sample={s.sample ? '' : undefined}>{s.name}</span>;
          const tile = s.link ? <a class="sp-link" href={s.link}>{mark}</a> : mark;
          // A credit goes under the tile, in the normal flow, so it never covers a logo or a name.
          return s.credit
            ? <li class="has-credit"><div class="sp-tile">{tile}</div><Credit credit={s.credit} /></li>
            : <li>{tile}</li>;
        })}
      </ul>
    </div>
  ))}
</div>
