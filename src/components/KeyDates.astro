---
// Key dates as a poster rail: one 3 px rail from Oct 1 to Apr 23, drawn to scale. The call for proposals is a
// bar from Nov 1 through Jan 31 (solid only while open), Mar 1 a tick, and Apr 23 the approved 2027 badge
// (unchanged; the KCD icon only with CNCF's file, A37) under its gold date plate. Big dates sit above the marks
// and small months with ticks under the rail. NOW is a magenta line with its tag in its own row; /now.js moves it
// between builds, on Event Day only the tag shows, and from May 1 there is none. Under the rail, four equal cards
// say what each date means; each card carries its date for screen readers (and on screen below 720 px), and a
// running item gets a magenta top rule. Positions are SVG attributes only: the build forbids inline styles.
// Critic round 2026-10-09.
import { getImage } from 'astro:assets';
import { home } from '../data/home';
import { asOfDay, edition2027, timeline, timelinePercent } from '../data/edition-2027';
import { contact, prospectus } from '../data/site';
import { paths } from '../data/nav';
import { badge } from '../lib/images';

type Item = (typeof home.dates.items)[number] & { bigTo?: string; from?: string; until?: string; ends?: string; undated?: boolean; echo?: boolean };
const e = edition2027;
const d = home.dates;
const items = d.items as Item[];
const byKey = (key: string) => items.find((it) => it.key === key)!;
const hrefs: Record<string, string> = { prospectus: prospectus.href, chapter: contact.chapterUrl, sponsors: paths.sponsors, cfp: paths.cfp };
const link = (detail: Item['detail']) => ('href' in detail ? hrefs[detail.href as string] : undefined);
const cards = items.filter((it) => it.key !== 'tix');
const tix = byKey('tix');
const live = (it: Item) =>
  it.key === 'spons' ? /open/i.test(it.status) : Boolean(it.from && it.from <= asOfDay && asOfDay <= (it.key === 'tix' ? it.ends ?? it.until! : it.until!));
const past = (it: Item) => Boolean((it.ends ?? it.until) && (it.ends ?? it.until)! < asOfDay);
const repeats = (it: Item) => it.status === it.big || it.status.startsWith(`${it.big} ·`);
const dateLine = (it: Item) => (it.bigTo ? `${it.big} – ${it.bigTo}` : it.key === 'spons' ? '' : it.big);

const next = (day: string) => { const t = new Date(`${day}T12:00:00Z`); t.setUTCDate(t.getUTCDate() + 1); return t.toISOString().slice(0, 10); };
const pct = (day: string) => `${timelinePercent(day).toFixed(2)}%`;
const cfpEnd = next(e.cfp.closes);
const cfpOpen = asOfDay >= e.cfp.opens && asOfDay <= e.cfp.closes;
const cfpWidth = `${(timelinePercent(cfpEnd) - timelinePercent(e.cfp.opens)).toFixed(2)}%`;
const tixDay = e.tickets.onSale;
const showNow = asOfDay >= timeline.start && asOfDay < timeline.end;
const nowPct = timelinePercent(asOfDay);
const nowClass = ['pr-now', nowPct < 3 && 'at-start', nowPct > 94 && 'at-end', asOfDay === e.eventDay && 'at-event'];
const months = [['Oct', '2026-10-01'], ['Nov', '2026-11-01'], ['Dec', '2026-12-01'], ['Jan', '2027-01-01'], ['Feb', '2027-02-01'], ['Mar', '2027-03-01'], ['Apr', '2027-04-01']];
// The header's own badge file (same width and quality), so the marker adds no download.
const mark = await getImage({ src: badge, width: 240, quality: 70 });
const pastDate = (day: string) => (day < asOfDay ? 'pr-date pr-date--past' : 'pr-date');
---

<section class="dates" aria-labelledby="dates-title">
  <div class="wrap">
    <h2 id="dates-title" class="pr-title">{d.title}</h2>
    <div class:list={['pr', { 'pr--tix': tixDay }]} aria-hidden="true" data-pr data-start={timeline.start} data-end={timeline.end} data-event={e.eventDay}>
      <svg class="pr-svg pr-svg--wide" focusable="false">
        {showNow && (
          <svg class:list={nowClass} x={`${nowPct.toFixed(2)}%`} y="0" overflow="visible">
            <line class="pr-now-halo" x1="0" x2="0" y1="24" y2="104" />
            <line class="pr-now-line" x1="0" x2="0" y1="24" y2="104" />
            <g class="pr-tag pr-tag--mid"><rect x="-25" y="0" width="50" height="20" /><text x="0" y="14" text-anchor="middle">Now</text></g>
            <g class="pr-tag pr-tag--start"><rect x="0" y="0" width="50" height="20" /><text x="25" y="14" text-anchor="middle">Now</text></g>
            <g class="pr-tag pr-tag--end"><rect x="-50" y="0" width="50" height="20" /><text x="-25" y="14" text-anchor="middle">Now</text></g>
          </svg>
        )}
        <line class="pr-rail" x1="0" x2={pct(e.eventDay)} y1="92" y2="92" />
        <rect class:list={['pr-cfp', { 'pr-cfp--open': cfpOpen, 'pr-cfp--past': asOfDay > e.cfp.closes }]} x={pct(e.cfp.opens)} width={cfpWidth} y="88" height="8" />
        <line class="pr-tick" x1={pct(e.schedule)} x2={pct(e.schedule)} y1="80" y2="104" />
        {tixDay && <line class="pr-tix" x1={pct(tixDay)} x2={pct(e.eventDay)} y1="150" y2="150" />}
        {tixDay && <text class="pr-tix-label" x={pct(tixDay)} y="168">Tickets · {tix.big}</text>}
        <text class={pastDate(e.cfp.opens)} x={pct(e.cfp.opens)} dx="8" y="74">{byKey('cfp').big}</text>
        <text class={pastDate(e.cfp.closes)} x={pct(cfpEnd)} dx="-8" y="74" text-anchor="end">{byKey('cfp').bigTo}</text>
        <text class={pastDate(e.schedule)} x={pct(e.schedule)} y="74" text-anchor="middle">{byKey('sched').big}</text>
        <rect class="pr-plate" x="100%" y="26" width="168" height="56" transform="translate(-168 0)" />
        <text class="pr-date pr-date--event" x="100%" dx="-14" y="74" text-anchor="end">{byKey('event').big}</text>
        <svg x={pct(e.eventDay)} y="0" overflow="visible"><image href={mark.src} x="-24" y="96" width="48" height="48" /></svg>
        {months.map(([m, day]) => (
          <g class="pr-month"><line x1={pct(day)} x2={pct(day)} y1="98" y2="104" /><text x={pct(day)} dx="3" y="120">{m}</text></g>
        ))}
      </svg>
      <svg class="pr-svg pr-svg--narrow" focusable="false">
        {showNow && (
          <svg class:list={nowClass} x={`${nowPct.toFixed(2)}%`} y="0" overflow="visible">
            <line class="pr-now-halo" x1="0" x2="0" y1="18" y2="66" />
            <line class="pr-now-line" x1="0" x2="0" y1="18" y2="66" />
            <g class="pr-tag pr-tag--mid"><rect x="-21" y="0" width="42" height="18" /><text x="0" y="13" text-anchor="middle">Now</text></g>
            <g class="pr-tag pr-tag--start"><rect x="0" y="0" width="42" height="18" /><text x="21" y="13" text-anchor="middle">Now</text></g>
            <g class="pr-tag pr-tag--end"><rect x="-42" y="0" width="42" height="18" /><text x="-21" y="13" text-anchor="middle">Now</text></g>
          </svg>
        )}
        <line class="pr-rail" x1="0" x2={pct(e.eventDay)} y1="54" y2="54" />
        <rect class:list={['pr-cfp', { 'pr-cfp--open': cfpOpen, 'pr-cfp--past': asOfDay > e.cfp.closes }]} x={pct(e.cfp.opens)} width={cfpWidth} y="50" height="8" />
        <line class="pr-tick" x1={pct(e.schedule)} x2={pct(e.schedule)} y1="44" y2="64" />
        <text class={pastDate(e.cfp.opens)} x={pct(e.cfp.opens)} dx="4" y="38">{byKey('cfp').big}</text>
        <text class={pastDate(e.cfp.closes)} x={pct(cfpEnd)} dx="-4" y="38" text-anchor="end">{byKey('cfp').bigTo}</text>
        <text class={pastDate(e.schedule)} x={pct(e.schedule)} y="38" text-anchor="middle">{byKey('sched').big}</text>
        <text class="pr-date pr-date--event-n" x="100%" y="38" text-anchor="end">{byKey('event').big}</text>
        <svg x={pct(e.eventDay)} y="0" overflow="visible"><image href={mark.src} x="-18" y="40" width="34" height="34" /></svg>
      </svg>
    </div>
    <ol class:list={['pr-cards']} role="list">
      {cards.map((it) => (
        <li class:list={['pr-card', `pr-card--${it.key}`, { 'pr-card--echo': it.echo && Boolean(dateLine(it)), 'pr-card--live': live(it), 'pr-card--past': past(it) }]}>
          {dateLine(it) && <p class="pr-card-date">{dateLine(it)}</p>}
          <p class="it-name">{it.name}</p>
          <p class="it-st" aria-hidden={it.echo && dateLine(it) && repeats(it) ? 'true' : undefined}>{it.status}</p>
          <p class="it-dt">{link(it.detail) ? <a href={link(it.detail)}>{it.detail.text}</a> : it.detail.text}</p>
        </li>
      ))}
      <li class:list={['pr-card', 'pr-card--tix', 'pr-tix-line', { 'pr-card--live': live(tix) }]}>
        <p class="it-name">{tix.name}</p>
        <p class="it-st">{tix.status}</p>
        <p class="it-dt">{link(tix.detail) ? <a href={link(tix.detail)}>{tix.detail.text}</a> : tix.detail.text}</p>
      </li>
    </ol>
  </div>
  <script is:inline src="/now.js" defer></script>
</section>
