---
// Key dates: a tour strip from October to April. Every bar and mark sits at its date, computed at
// build time from the Edition file, so "Now" and "As of" follow the build day.
import { home } from '../data/home';
import { asOfDay, edition2027, shortDateYear, timeline, timelinePercent } from '../data/edition-2027';
import { contact, prospectus } from '../data/site';

const e = edition2027;
const pct = (day: string) => `${timelinePercent(day).toFixed(2)}%`;
const width = (from: string, to: string) => `${(timelinePercent(to) - timelinePercent(from)).toFixed(2)}%`;
const eventMonth = `${e.eventDay.slice(0, 8)}01`;
const hrefs: Record<string, string> = { prospectus: prospectus.href, chapter: contact.chapterUrl };
const months = ['Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar', 'Apr'];
// "Now" sits left of its line, except near the strip's start, where it would run off the edge.
const nowLeft = timelinePercent(asOfDay) > 6;
---

<section class="dates" aria-labelledby="dates-title">
  <div class="wrap">
    <h2 id="dates-title" class="dates-title">Key dates <span>As of {shortDateYear(asOfDay)}</span></h2>
    <div class="tl" aria-hidden="true">
      <div class="tl-months">{months.map((m) => m === 'Jan' ? <span>Jan <i>{e.year}</i></span> : <span>{m}</span>)}</div>
      <svg class="tl-track" focusable="false">
        <line class="tl-axis" x1="0" x2="100%" y1="50%" y2="50%" />
        <line class="tl-past" x1="0" x2={pct(asOfDay)} y1="50%" y2="50%" />
        <rect class="tl-bar--cfp" x={pct(e.cfp.opens)} width={width(e.cfp.opens, e.cfp.closes)} y="11" height="12" />
        <rect class="tl-bar--tix" x={pct(e.tickets.onSale)} width={width(e.tickets.onSale, eventMonth)} y="11" height="12" />
        <svg x={pct(e.schedule)} y="17" overflow="visible"><rect class="tl-mark" x="-7" y="-7" width="14" height="14" transform="rotate(45)" /></svg>
        <rect class="tl-event" x={pct(eventMonth)} width={width(eventMonth, timeline.end)} y="0" height="34" />
        <text class="tl-event-label" x={`${((timelinePercent(eventMonth) + 100) / 2).toFixed(2)}%`} y="17" text-anchor="middle" dominant-baseline="central">{e.city}</text>
        <line class="tl-now" x1={pct(asOfDay)} x2={pct(asOfDay)} y1="-10" y2="44" />
        <text class="tl-now-label" x={pct(asOfDay)} dx={nowLeft ? -7 : 7} y="9" text-anchor={nowLeft ? 'end' : 'start'} dominant-baseline="central">Now</text>
      </svg>
    </div>
    <ol class="tl-list">
      {home.dates.items.map((it) => (
        <li class={`tl-it tl-it--${it.key}`}>
          <p class="it-name">{it.name}</p>
          <p class="it-st">{it.status}</p>
          <p class="it-dt">{'href' in it.detail ? <a href={hrefs[it.detail.href as string]}>{it.detail.text}</a> : it.detail.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
