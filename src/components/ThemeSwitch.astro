---
// The theme switch. /theme.js shows it, fills in its words and handles clicks; without JavaScript
// it stays hidden and the device setting decides the theme through CSS alone.
---

<button type="button" class="theme" data-theme-toggle data-now="light" hidden>
  <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z" /></svg>
  <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.5" fill="currentColor" /><path stroke="currentColor" stroke-width="2" stroke-linecap="square" d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" /></svg>
  <span class="sr-only theme-now">Light theme. Switch to </span><span class="theme-word">Dark</span>
</button>
<span class="sr-only theme-status" role="status"></span>
