---
// A door: one big action button, filled or outlined, with an optional short note under it.
interface Props {
  href: string;
  label: string;
  note?: string;
  /** Outlined instead of filled: the hero keeps one filled button (release 4 critique). */
  line?: boolean;
}
const { href, label, note, line = false } = Astro.props;
---

<div class="door">
  <a class:list={['btn', 'btn--door', { 'btn--line': line }]} href={href}>{label}</a>
  {note && <p class="door-note">{note}</p>}
</div>
