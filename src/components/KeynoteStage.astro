---
// The 2026 stage: the three keynotes, the 2026 bill, the open 2027 slot and more 2026 talks.
import { Image } from 'astro:assets';
import Bill2026 from './Bill2026.astro';
import { home } from '../data/home';
import { edition2026, youtube } from '../data/edition-2026';
import { cfpPath } from '../data/nav';
import { edition2027 } from '../data/edition-2027';
import { faces, keynotePhotos, recapPoster } from '../lib/images';

const st = home.stage;
---

<section id="last-year" class="stage" aria-labelledby="stage-title">
  <div class="wrap">
    <div class="stage-head">
      <p class="kicker">{st.kicker}</p>
      <h2 id="stage-title" class="stage-title">{st.title}</h2>
      <p class="stage-count">{st.count}</p>
    </div>
    <ul class="keynotes">
      {edition2026.keynotes.map((k) => (
        <li class="kn">
          <Image class="kn-photo" src={keynotePhotos[k.photo]} quality={70} widths={[720, 1200]} sizes="(min-width: 1440px) 432px, (min-width: 600px) 30vw, 38vw" alt={k.alt} />
          <p class="kn-meta"><b>{k.time}</b> Keynote</p>
          <h3 class="kn-name">{k.name}</h3>
          <p class="kn-aff">{k.affiliation}</p>
          <p class="kn-talk">{k.talk}</p>
          {k.youtube && <a class="watch" href={youtube(k.youtube)}>Watch on YouTube<span class="sr-only">: {k.talk}</span></a>}
        </li>
      ))}
    </ul>
    <p class="as-printed">{st.asPrinted}</p>
    <Bill2026 />
    <a class="slot slot--end" href={cfpPath}><span class="slot-year">{edition2027.year}</span><span class="slot-label">Your End-User Story here</span><span class="arrow" aria-hidden="true">→</span></a>
    <div class="talks-block">
      <div class="recap-col">
        <h3 class="h3">{st.recordings}</h3>
        <a class="recap" href={edition2026.recapUrl}>
          <span class="recap-frame"><Image src={recapPoster} quality={70} widths={[640, 1200]} sizes="(min-width: 1100px) 420px, (min-width: 600px) 60vw, 100vw" alt="" /><span class="play" aria-hidden="true"></span></span>
          <span class="recap-text">Watch the 2026 recap video</span>
        </a>
        <p class="more"><a href={edition2026.talksUrl}>Watch all 2026 talks</a></p>
      </div>
      <div class="talks-col">
        <h3 class="h3">{st.talksTitle}</h3>
        <ul class="talks">
          {edition2026.talks.map((t) => (
            <li class="talk">
              <Image src={faces[t.face]} width={144} height={144} alt="" />
              <div>
                <p class="talk-who"><b>{t.name}</b> {t.affiliation}</p>
                <p class="talk-title">{t.title}</p>
                <a class="watch" href={youtube(t.youtube)}>Watch on YouTube<span class="sr-only">: {t.title}</span></a>
              </div>
            </li>
          ))}
        </ul>
        <p class="as-printed">{st.asPrinted}</p>
      </div>
    </div>
  </div>
</section>
