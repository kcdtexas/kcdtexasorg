---
// The 2026 stage: the three keynotes, the 2026 bill, the recap video with a link to the full program on /2026/, and
// the open 2027 slot.
// The slot asks for End-User Stories in the CFP Phase, then points to the 2027 keynotes, or to the Speakers while
// only they are public.
import { Image } from 'astro:assets';
import Bill2026 from './Bill2026.astro';
import Credit from './program/Credit.astro';
import { home } from '../data/home';
import { edition2026, youtube } from '../data/edition-2026';
import { cfpPath, paths } from '../data/nav';
import { edition2027, phase, programState } from '../data/edition-2027';
import { keynotePhotos, recapPoster } from '../lib/images';
import { speakerCredit } from '../lib/loyalty';

const st = home.stage;
---

<section id="last-year" class="stage" aria-labelledby="stage-title">
  <div class="wrap">
    <div class="stage-head">
      <p class="kicker">{st.kicker}</p>
      <h2 id="stage-title" class="stage-title">{st.title}</h2>
      <p class="stage-count">{st.count}</p>
    </div>
    <ul class="keynotes">
      {edition2026.keynotes.map((k) => (
        <li class="kn">
          <Image class="kn-photo" src={keynotePhotos[k.photo]} quality={70} widths={[720, 1200]} sizes="(min-width: 1440px) 432px, (min-width: 600px) 30vw, 38vw" alt={k.alt} />
          <p class="kn-meta"><b>{k.time}</b> Keynote</p>
          <h3 class="kn-name">{k.name}</h3>
          <p class="kn-aff">{k.affiliation}</p>
          <Credit credit={speakerCredit(k.name, 2026)} role="Speaker" />
          <p class="kn-talk">{k.talk}</p>
          {k.youtube && <a class="watch" href={youtube(k.youtube)}>Watch on YouTube<span class="sr-only">: {k.talk}</span></a>}
        </li>
      ))}
    </ul>
    <p class="as-printed">{st.asPrinted}</p>
    <Bill2026 />
    {/* The recap video: its title plays it in the site's player (/watch.js). The poster is a second way in for the
        mouse, so screen readers and the Tab key skip it; its hidden words name the player. */}
    <div class="recap-row">
      <a data-watch class="recap-poster" href={edition2026.recapUrl} tabindex="-1" aria-hidden="true">
        <Image src={recapPoster} quality={70} widths={[640, 1200]} sizes="(min-width: 600px) 400px, 44vw" alt="" />
        <span class="play"></span>
        <span class="sr-only">{st.recap}</span>
      </a>
      <div class="recap-body">
        <p class="recap-kicker">{st.recapKicker}</p>
        <a data-watch class="recap-title" href={edition2026.recapUrl}>{st.recap}</a>
        <p class="more"><a href={`${paths.edition2026}#program`}>{st.programLink}</a></p>
      </div>
    </div>
    {/* The open 2027 slot: an End-User Story in the CFP Phase; from Feb 1, the 2027 keynotes, by the program's gate. */}
    {phase === 'cfp'
      ? <a class="slot slot--end" href={cfpPath}><span class="slot-year">{edition2027.year}</span><span class="slot-label">Your End-User Story here</span><span class="arrow" aria-hidden="true">→</span></a>
      : <a class="slot slot--end" href={programState() === 'speakers' ? paths.speakers : paths.schedule}><span class="slot-year">{edition2027.year}</span><span class="slot-label">{st.slot2027}</span><span class="arrow" aria-hidden="true">→</span></a>}
  </div>
</section>
