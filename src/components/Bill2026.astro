---
// The 2026 bill: keynotes in the day's order, every Speaker by surname, then the hosts.
// Desktop and tablet rows are fitted to the measure; phones show the keynotes and a disclosure. Below it, the
// returning Speakers grouped by their credit as of 2026 (src/lib/loyalty.ts), most Editions first, outside the
// fitted rows.
import Credit from './program/Credit.astro';
import { edition2026 } from '../data/edition-2026';
import { speakerCredit } from '../lib/loyalty';

const b = edition2026.bill;
const total = `See all ${edition2026.speakers} Speakers and ${edition2026.hosts} hosts`;
const and = (list: string[]) => (list.length < 2 ? list.join('') : `${list.slice(0, -1).join(', ')} and ${list.at(-1)}`);
const returning = [...b.keynotes, ...b.speakers.map(([n]) => n)]
  .map((n) => ({ n, credit: speakerCredit(n, 2026) }))
  .filter((r) => r.credit);
const counts = [...new Set(returning.map((r) => r.credit!.editions))].sort((a, b) => b - a);
const groups = counts.map((n) => {
  const same = returning.filter((r) => r.credit!.editions === n);
  return { credit: same[0].credit, names: and(same.map((r) => r.n)) };
});
---

<div class="bill26">
  <h3 class="bill26-title">The 2026 bill</h3>
  <ul class="bl bl-key">{b.keynotes.map((n, i) => <li class={`k${i + 1}`}>{n}</li>)}</ul>
  <ul class="bl bl-all">{b.speakers.map(([n, wide]) => <li class={wide}>{n}</li>)}</ul>
  <p class="bl-by">Hosted by</p>
  <ul class="bl bl-hosts">{b.hosts.map((n) => <li>{n}</li>)}</ul>
  <details class="bl-more">
    <summary>{total}</summary>
    <ul class="bl bl-n">{b.speakers.map(([n, , phone]) => <li class={phone}>{n}</li>)}</ul>
    <p class="bl-by">Hosted by</p>
    <ul class="bl bl-hosts">{b.hosts.map((n) => <li>{n}</li>)}</ul>
  </details>
  {groups.length > 0 && (
    <ul class="bl-since">{groups.map((g) => <li><Credit credit={g.credit} role="Speaker" /><span>{g.names}</span></li>)}</ul>
  )}
</div>
