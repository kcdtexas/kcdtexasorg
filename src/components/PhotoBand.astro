---
// The 2026 photo band under the hero, captioned with 2026's verified numbers.
// Phones get a tighter crop of the afternoon session.
import { getImage } from 'astro:assets';
import { home } from '../data/home';
import { edition2026 } from '../data/edition-2026';
import { photos } from '../lib/images';

const h = home.hero;
const wide = photos['band-043-171'];
const phone = photos['band-171-phone'];
const [w1, w2, p1, p2] = await Promise.all([
  getImage({ src: wide, width: 1344, format: 'webp', quality: 70 }),
  getImage({ src: wide, width: 2688, format: 'webp', quality: 70 }),
  getImage({ src: phone, width: 780, format: 'webp', quality: 70 }),
  getImage({ src: phone, width: 964, format: 'webp', quality: 70 }),
]);
---

<figure class="band">
  <figcaption>
    <p class="proof"><strong>{h.proofLead}</strong> <span><b>{edition2026.checkedIn}</b> checked in</span> <i aria-hidden="true">·</i> <span><b>{edition2026.speakers}</b> Speakers</span> <i aria-hidden="true">·</i> <span><b>{edition2026.sponsorCount}</b> sponsors</span> <i aria-hidden="true">·</i> <span>{edition2026.recordings} talks on YouTube</span></p>
    <p class="cap">{h.caption.map((c, i) => <>{i > 0 && ' · '}{c.time && <b>{c.time}</b>}{c.time && ' '}{c.text}</>)}</p>
  </figcaption>
  <picture>
    <source media="(max-width: 599px)" srcset={`${p1.src} 780w, ${p2.src} 964w`} sizes="100vw" width={phone.width} height={phone.height} />
    <img src={w1.src} srcset={`${w1.src} 1344w, ${w2.src} 2688w`} sizes="(min-width: 1440px) 1344px, 94vw" width={wide.width} height={wide.height} alt={h.bandAlt} decoding="async" fetchpriority="high" />
  </picture>
</figure>
