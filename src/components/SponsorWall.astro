---
// The 2026 sponsor wall by tier: equal cells per tier, each logo centered in its cell (see wall.css).
// The home page uses the defaults, under the 2027 section (NextSponsors.astro); the sponsors page
// passes its own title and a year before each tier name.
import SponsorTiers from './SponsorTiers.astro';
import { home } from '../data/home';
import { edition2026 } from '../data/edition-2026';

interface Props {
  title?: string;
  /** Put before each tier name, such as "2026". */
  tierPrefix?: string;
  /** Drop the full-width wrapper, for use inside a page column. */
  bare?: boolean;
}
const { title = home.wall.title, tierPrefix, bare = false } = Astro.props;
---

<section class:list={['wall', { 'wall--bare': bare }]} aria-labelledby="wall-title">
  <div class:list={{ wrap: !bare }}>
    <h2 id="wall-title" class="wall-title">{title}</h2>
    <SponsorTiers tierPrefix={tierPrefix} />
    <p class="partners">{edition2026.partners}</p>
  </div>
</section>
