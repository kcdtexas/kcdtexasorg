---
import { Image } from 'astro:assets';
import ThemeSwitch from './ThemeSwitch.astro';
import { badge } from '../lib/images';
import { cfpPath, mainNav, isCurrent, paths } from '../data/nav';
import { contact, prospectus } from '../data/site';
import { cfpStatus, sponsorshipsStatus } from '../data/edition-2027';

// Every page, the home page included, links to the pages; the current one is marked.
const links = mainNav.map((l) => ({ ...l, current: isCurrent(l.href, Astro.url.pathname) }));
// The filled button follows the Phase (owner's choice, release 4 round 3): "Submit a talk" while the call is open,
// "Sponsor" while sponsorships are open, then "Get ticket news", the key dates' tickets link. It changes only on
// rebuild days (the CFP opens and closes; sponsorships close).
const cta = cfpStatus() === 'Open now' ? { href: cfpPath, label: 'Submit a talk' }
  : sponsorshipsStatus() === 'Open now' ? { href: prospectus.href, label: 'Sponsor' }
  : { href: contact.chapterUrl, label: 'Get ticket news' };
// While the button says "Sponsor", the wide nav drops its own Sponsor link (the button already goes there) and the
// button marks the current page in its place. The phone menu keeps every link (owner's choice, release 4 round 4).
const sponsorCta = cta.label === 'Sponsor';
const wideLinks = sponsorCta ? links.filter((l) => l.href !== paths.sponsors) : links;
const ctaCurrent = sponsorCta && isCurrent(cta.href, Astro.url.pathname);
---

<header class="site-header">
  <div class="wrap head">
    <a class="lockup" href="/">
      <img class="lockup-kcd logo-on-light" src="/brand/kcd-logo-black.svg" width="870" height="280" alt="Kubernetes Community Days" />
      <img class="lockup-kcd logo-on-dark" src="/brand/kcd-logo-white.svg" width="870" height="280" alt="Kubernetes Community Days" />
      <span class="lockup-rule" aria-hidden="true"></span>
      <Image class="lockup-badge" src={badge} quality={70} widths={[240, 600]} sizes="64px" alt="KCD Texas 2027 badge, Dallas" loading="eager" />
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        {wideLinks.map((l) => <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="head-end">
      <a class="btn btn--sm head-cta" href={cta.href} aria-current={ctaCurrent ? 'page' : undefined}>{cta.label}</a>
      <ThemeSwitch />
      <details class="menu">
        <summary><svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke="currentColor" stroke-width="2.5" d="M3 6h18M3 12h18M3 18h18" /></svg><span class="menu-word">Menu</span></summary>
        <nav class="menu-panel" aria-label="Main, phone">
          <ul>
            {links.map((l) => <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>)}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
