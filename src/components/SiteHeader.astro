---
import { Image } from 'astro:assets';
import ThemeSwitch from './ThemeSwitch.astro';
import { badge } from '../lib/images';
import { mainNav, isCurrent, paths } from '../data/nav';
import { headerCta as cta } from '../data/actions';
import { pastEditionsMenu as pe } from '../data/editions';

// Every page, the home page included, links to the pages; the current one is marked.
const links = mainNav.map((l) => ({ ...l, current: isCurrent(l.href, Astro.url.pathname) }));
// The filled button follows the state (headerCta in data/actions.ts): in the CFP Phase "Submit a talk" while the
// call is open, then "Sponsor"; from Feb 1, "Tickets"; on Event Day, "Schedule" once it is public, else "Travel";
// in the Recap, "Schedule" or "2026 talks". It changes only on rebuild days or with the data releases.
// While the button opens the sponsors page, the wide nav drops its own Sponsor link (the button already goes there)
// and the button marks the current page in its place. Once the button opens the prospectus PDF instead, the link
// comes back. The phone menu keeps every link (owner's choice, release 4 round 4).
const sponsorCta = cta.label === 'Sponsor' && cta.href === paths.sponsors;
const wideLinks = sponsorCta ? links.filter((l) => l.href !== paths.sponsors) : links;
const ctaCurrent = sponsorCta && isCurrent(cta.href, Astro.url.pathname);
// "Past Editions" is a <details>, like the phone menu: no script. It marks the page you're on, and its summary is
// underlined through CSS (:has) on a past page and on the Editions page.
const here = (href: string) => (isCurrent(href, Astro.url.pathname) ? 'page' : undefined);
---

<header class="site-header">
  <div class="wrap head">
    <a class="lockup" href="/">
      <img class="lockup-kcd logo-on-light" src="/brand/kcd-logo-black.svg" width="870" height="280" alt="Kubernetes Community Days" />
      <img class="lockup-kcd logo-on-dark" src="/brand/kcd-logo-white.svg" width="870" height="280" alt="Kubernetes Community Days" />
      <span class="lockup-rule" aria-hidden="true"></span>
      <Image class="lockup-badge" src={badge} quality={70} widths={[240, 600]} sizes="64px" alt="" loading="eager" /><span class="sr-only">KCD Texas</span>
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        {wideLinks.map((l) => 'menu' in l ? (
          <li>
            <details class="pe">
              <summary>{l.label}<svg class="pe-chevron" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M1.5 4l4.5 4.5L10.5 4" fill="none" stroke="currentColor" stroke-width="2" /></svg></summary>
              <ul class="pe-panel">
                {pe.years.map((y) => <li><a href={y.href} aria-current={here(y.href)}><b class="pe-year">{y.year}</b> <span class="pe-line">{y.line}</span></a></li>)}
                <li><a class="pe-all" href={pe.all.href} aria-current={here(pe.all.href)}>{pe.all.text}<span aria-hidden="true"> →</span></a></li>
              </ul>
            </details>
          </li>
        ) : <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="head-end">
      <a class="btn btn--sm head-cta" href={cta.href} aria-current={ctaCurrent ? 'page' : undefined}>{cta.label}</a>
      <ThemeSwitch />
      <details class="menu">
        <summary><svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke="currentColor" stroke-width="2.5" d="M3 6h18M3 12h18M3 18h18" /></svg><span class="menu-word">Menu</span></summary>
        <nav class="menu-panel" aria-label="Main, phone">
          <ul>
            {links.map((l) => 'menu' in l ? (
              <li class="menu-pe">
                <span class="menu-pe-label" id="menu-pe" aria-hidden="true">{l.label}</span>
                <ul class="menu-years" aria-labelledby="menu-pe">
                  {pe.years.map((y) => <li><a href={y.href} aria-current={here(y.href)}>{y.year}</a></li>)}
                </ul>
                <a class="menu-pe-all" href={pe.all.href} aria-current={here(pe.all.href)}>{pe.all.text}<span aria-hidden="true"> →</span></a>
              </li>
            ) : <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>)}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
