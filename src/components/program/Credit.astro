---
// A loyalty credit (src/lib/loyalty.ts): a tab with the count of Editions, "3rd year", which screen readers hear as
// "3rd year as an Organizer". Nothing for a first Edition. credit.css sets where it sits: on a person's photo, after
// a Speaker's name, under a sponsor's logo or at the start of a line in the 2026 bill.
import { creditText, type Credit } from '../../lib/loyalty';

interface Props {
  credit: Credit | null;
  /** "Speaker" or "Organizer"; none for a sponsor. */
  role?: 'Speaker' | 'Organizer';
}
const { credit, role } = Astro.props;
const as = role === 'Organizer' ? ' as an Organizer' : role === 'Speaker' ? ' as a Speaker' : ' as a sponsor';
---

{credit && <span class="credit">{creditText(credit)}<span class="sr-only">{as}</span></span>}
