---
// "Add to My Schedule", then "Remove from My Schedule": kept in this browser only (/schedule.js, localStorage).
// Hidden without JavaScript, which shows it and sets data-on. Its id and its words for screen readers come from the
// program platform (data-ugc). None while only the Speakers are public: My Schedule is a view of the Schedule.
import { program, type Session } from '../../lib/program';

interface Props {
  session: Session;
  /** The visible words; the Schedule's compact button shows only the star. */
  words?: boolean;
}
const { session: s, words = false } = Astro.props;
---

{program?.schedulePublic && (
  <button type="button" class:list={['star', { 'star--words': words }]} data-star={s.id} hidden data-ugc>
    <svg class="star-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z" /></svg>
    {words ? <span class="star-words">Add to My Schedule</span> : <span class="sr-only">Add to My Schedule: {s.title}</span>}
  </button>
)}
