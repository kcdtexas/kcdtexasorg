---
// One Session in a list: the badges, the title linking to its page, the Speakers, the time and room as text, and
// the My Schedule star. The data attributes feed the filters and My Schedule (/schedule.js).
import Badges from './Badges.astro';
import Star from './Star.astro';
import { paths } from '../../data/nav';
import { program, speakersOf, timeRange, type Session } from '../../lib/program';

interface Props {
  session: Session;
  /** The heading level of the title. */
  level?: 'h2' | 'h3' | 'h4';
  /** Leave out the Speakers (on a Speaker's own page). */
  noSpeakers?: boolean;
}
const { session: s, level: H = 'h3', noSpeakers = false } = Astro.props;
const who = speakersOf(s);
const url = `${paths.sessions}${s.slug}/`;
---

<li class="sch-item" data-id={s.id} data-format={s.format} data-room={s.room ?? ''} data-eu={s.endUser ? '1' : '0'} data-start={s.start ?? ''} data-end={s.end ?? ''} data-url={url}>
  <Badges session={s} />
  <H class="sch-title"><a href={url}>{s.title}</a></H>
  {!noSpeakers && <p class="sch-who">{who.map((p, i) => <>{i > 0 && ', '}<a href={`${paths.speakers}${p.slug}/`}>{p.name}</a></>)}</p>}
  {program!.schedulePublic && s.start && s.end && (
    <p class="sch-meta"><span class="sch-time">{timeRange(s.start, s.end)}</span><span class="sch-room">{s.room}</span></p>
  )}
  <Star session={s} />
</li>
