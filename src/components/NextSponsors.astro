---
// The 2027 sponsors, above the 2026 wall on the home page. Until the first 2027 sponsor is announced,
// it holds the open spot and says that 2027 sponsors replace the 2026 wall (the owner, 2026-10-08).
// With the first sponsor, their logos go here, the spot reads "Your logo here", and the 2026 wall
// leaves the home page.
import { home } from '../data/home';
import { paths } from '../data/nav';

const n = home.wall.next;
---

<section class="wall wall--next" aria-labelledby="next-title">
  <div class="wrap">
    <h2 id="next-title" class="wall-title">{n.title}</h2>
    <div class="wall-next">
      <a class="slot slot--logo" href={paths.sponsors}><span class="slot-label">{n.slot}</span><span class="slot-sub">{n.link}<span class="arrow" aria-hidden="true">→</span></span></a>
    </div>
    <p class="wall-note">{n.note}</p>
  </div>
</section>
