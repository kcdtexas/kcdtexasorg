---
// One Organizer's card, in a `.pg-org` list: the photo, the name, the line their Edition's record printed (employer
// and title), and the "Organizer since" credit. Without a photo, their initials take its place, as a Speaker's do.
// The photo is decorative, since the name is next to it. The About page, the home page and every Edition's page
// use it.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Credit from './program/Credit.astro';
import type { Credit as CreditData } from '../lib/loyalty';

interface Props {
  name: string;
  photo?: ImageMetadata | null;
  /** What the record printed with the name, such as "Red Hat · Product Manager"; nothing when it printed none. */
  line?: string;
  credit: CreditData | null;
}
const { name, photo, line, credit } = Astro.props;
const initials = name.split(/\s+/).filter((w) => /^\p{L}/u.test(w)).map((w) => w[0]).slice(0, 2).join('');
---

<li>
  {photo
    ? <Image class="pg-org-photo" src={photo} quality={70} widths={[160, 320]} sizes="160px" alt="" loading="lazy" />
    : <svg class="pg-org-photo" viewBox="0 0 120 120" aria-hidden="true" focusable="false" data-initials><text x="60" y="60" text-anchor="middle" dominant-baseline="central" fill="currentColor" font-size="44" font-weight="900">{initials}</text></svg>}
  <b>{name}</b>
  {line && <span class="pg-aff">{line}</span>}
  <Credit credit={credit} role="Organizer" />
</li>
