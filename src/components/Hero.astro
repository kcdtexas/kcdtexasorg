---
import DateLine from './DateLine.astro';
import Bill2027 from './Bill2027.astro';
import Door from './Door.astro';
import PhotoBand from './PhotoBand.astro';
import { home } from '../data/home';
import { legal } from '../data/site';
import { heroDoors } from '../data/actions';
import { edition2027 } from '../data/edition-2027';

const h = home.hero;
---

<section class="hero" aria-labelledby="title">
  <div class="wrap hero-grid">
    <div class="hero-top">
      <p class="eyebrow"><a href={legal.kcdProgramUrl}>Kubernetes Community Days</a></p>
      <DateLine />
    </div>
    <h1 id="title" class="title">KCD Texas <span class="yr">{edition2027.year}</span></h1>
    <Bill2027 />
    <p class="promise">{h.promise}</p>
    <div class="hero-act">
      {/* One filled button (heroDoors in data/actions.ts): sponsors first in the CFP Phase (CONTEXT.md), tickets in
          the Countdown; the header's filled button says "Submit a talk" while the call is open. */}
      <div class="doors">
        {heroDoors.map((d) => <Door href={d.href} label={d.label} line={d.line} />)}
      </div>
    </div>
    <PhotoBand />
  </div>
</section>
