---
import Base from '../layouts/Base.astro';
import { contact } from '../data/site';
---

<Base title="Page not found · KCD Texas" description="This page doesn't exist on kcdtexas.org.">
  <section class="cfp wrap">
    <h1 class="cfp-title">This page doesn't exist</h1>
    <p class="lead cfp-lead">
      It may have moved. Try the <a href="/">homepage</a>, or email
      <a href={`mailto:${contact.email}`}>{contact.email}</a> and we'll point you to it.
    </p>
  </section>
</Base>
