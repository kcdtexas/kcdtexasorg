---
import '../styles/global.css';
import themeColor from '../foundation/theme-color.json';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { cards, CARD, type CardId } from '../lib/cards/cards';
import { jsonLdText } from '../lib/structured-data';

interface Props {
  title: string;
  description: string;
  /** The page's main element class, for page-level layout. */
  mainClass?: string;
  /** The page's link-preview card (src/pages/cards): a site card, or a program page's own card with its alt text;
   *  the title card when the page has none of its own. */
  card?: CardId | { id: string; alt: string };
  /** A program page: its script (/schedule.js: My Schedule, the filters, Event Day's now and next, and offline use)
   *  and its styles (/schedule.css). */
  schedule?: boolean;
  /** Structured data for search engines, as a JSON-LD object (src/lib/structured-data.ts). */
  jsonLd?: object;
  /** The 404 page: no canonical address of its own (hosts serve it at many), and kept out of search results. */
  notFound?: boolean;
}

const { title, description, mainClass, card = 'default', jsonLd, notFound = false, schedule = false } = Astro.props;
const cardId = typeof card === 'string' ? card : card.id;
const cardAlt = typeof card === 'string' ? cards[card].alt : card.alt;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Link previews need an absolute image URL. Preview builds set CARD_ORIGIN to their own address.
const cardUrl = new URL(`/cards/${cardId}.png`, import.meta.env.CARD_ORIGIN || Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {notFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo/archivo-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={themeColor.light} media="(prefers-color-scheme: light)" data-for="light" data-light={themeColor.light} data-dark={themeColor.dark} />
    <meta name="theme-color" content={themeColor.dark} media="(prefers-color-scheme: dark)" data-for="dark" data-light={themeColor.light} data-dark={themeColor.dark} />
    <!-- Applies a remembered theme before the first paint. Same-origin, so the CSP needs no inline code. -->
    <script is:inline src="/theme.js"></script>
    {schedule && <script is:inline src="/schedule.js" defer></script>}
    {schedule && <link rel="stylesheet" href="/schedule.css" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KCD Texas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={notFound ? new URL('/', Astro.site) : canonical} />
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(CARD.width)} />
    <meta property="og:image:height" content={String(CARD.height)} />
    <meta property="og:image:alt" content={cardAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLdText(jsonLd)} />}
  </head>
  <body id="top">
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
