---
import '../styles/global.css';
import themeColor from '../foundation/theme-color.json';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /** The page's main element class, for page-level layout such as the CFP Phase order. */
  mainClass?: string;
}

const { title, description, mainClass } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo/archivo-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={themeColor.light} media="(prefers-color-scheme: light)" data-for="light" data-light={themeColor.light} data-dark={themeColor.dark} />
    <meta name="theme-color" content={themeColor.dark} media="(prefers-color-scheme: dark)" data-for="dark" data-light={themeColor.light} data-dark={themeColor.dark} />
    <!-- Applies a remembered theme before the first paint. Same-origin, so the CSP needs no inline code. -->
    <script is:inline src="/theme.js"></script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KCD Texas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body id="top">
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
