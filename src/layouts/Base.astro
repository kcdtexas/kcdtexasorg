---
import '../styles/global.css';
import { contact, legal } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/clarity-city/ClarityCity-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/clarity-city/ClarityCity-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KCD Texas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body class="bg-bg text-fg antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-contrast">
      Skip to content
    </a>

    <header class="mx-auto flex max-w-5xl items-center gap-3 px-6 pt-8">
      <a href="/" class="flex items-center gap-3" aria-label="KCD Texas home">
        <picture>
          <source srcset="/brand/kcd-logo-white.svg" media="(prefers-color-scheme: dark)" />
          <img src="/brand/kcd-logo-color.svg" alt="" width="140" height="45" />
        </picture>
        <span class="text-2xl font-bold tracking-tight">Texas</span>
      </a>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-24 border-t border-line">
      <div class="mx-auto grid max-w-5xl gap-8 px-6 py-12 text-sm text-muted sm:grid-cols-3">
        <div>
          <p class="font-semibold text-fg">Contact</p>
          <p class="mt-2"><a class="underline underline-offset-4 hover:text-fg" href={`mailto:${contact.email}`}>{contact.email}</a></p>
          <ul class="mt-2 space-y-1">
            {contact.social.map((s) => (
              <li><a class="underline underline-offset-4 hover:text-fg" href={s.url} rel="noopener">{s.label}: {s.handle}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-semibold text-fg">Community</p>
          <ul class="mt-2 space-y-1">
            <li><a class="underline underline-offset-4 hover:text-fg" href={legal.codeOfConductUrl}>Code of Conduct</a></li>
            <li><a class="underline underline-offset-4 hover:text-fg" href={contact.chapterUrl}>KCD Texas chapter on the CNCF community site</a></li>
            <li><a class="underline underline-offset-4 hover:text-fg" href={contact.communityUrl}>Cloud Native Texas</a></li>
            <li><a class="underline underline-offset-4 hover:text-fg" href={contact.githubUrl}>KCD Texas on GitHub</a></li>
          </ul>
        </div>
        <div class="space-y-2">
          <p class="font-semibold text-fg">About this site</p>
          <p>This site sets no cookies and collects no personal data.</p>
          <p>
            KCD Texas is a community-organized Kubernetes Community Day supported by the Cloud Native Computing Foundation.
            CNCF and the CNCF logo design are registered trademarks of the Cloud Native Computing Foundation.
            For Linux Foundation trademarks, see the <a class="underline underline-offset-4 hover:text-fg" href={legal.lfTrademarksUrl}>Trademark Usage page</a>.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
